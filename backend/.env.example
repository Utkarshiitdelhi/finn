# Copy to backend/.env and fill in. Never commit .env.
# Supabase → Project settings → Database → Connection string (URI). Use the *session pooler* URI (port 5432) for Render.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google AI Studio → Get API key (free tier)
GEMINI_API_KEY=
# console.groq.com → API keys (free tier)
GROQ_API_KEY=

# Optional: only if you turn on "enhanced push security" in Expo
EXPO_ACCESS_TOKEN=
# Any random string; protects POST /admin/run/<job>
ADMIN_TOKEN=change-me

# Model names change: check the providers' model lists when you create the keys
GEMINI_SMALL_MODEL=gemini-flash-lite-latest
GEMINI_MID_MODEL=gemini-flash-latest
GEMINI_STRONG_MODEL=gemini-pro-latest
GROQ_SMALL_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
